+    private fun findSu(): String? {
+        val direct = SU_CANDIDATES.firstOrNull { File(it).canExecute() }
+        if (direct != null) return direct
+        return System.getenv("PATH").orEmpty()
+            .split(File.pathSeparatorChar)
+            .asSequence()
+            .map { File(it, "su") }
+            .firstOrNull { it.canExecute() }
+            ?.absolutePath
+    }
