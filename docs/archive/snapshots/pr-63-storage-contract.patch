diff --git a/src/android/app/src/androidTest/java/io/github/slackerllc/minis/runtime/RuntimeInstalledLayoutTest.kt b/src/android/app/src/androidTest/java/io/github/slackerllc/minis/runtime/RuntimeInstalledLayoutTest.kt
