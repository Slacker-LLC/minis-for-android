++#[cfg(unix)]
++fn is_tar_date(value: &str) -> bool {
++    value.len() == 10
++        && value.as_bytes()[4] == b'-'
++        && value.as_bytes()[7] == b'-'
++        && value
++            .bytes()
++            .enumerate()
++            .all(|(index, byte)| matches!(index, 4 | 7) || byte.is_ascii_digit())
++}
