++#[cfg(unix)]
++fn tar_listing_size(line: &str) -> Option<u64> {
++    let fields = line.split_whitespace().collect::<Vec<_>>();
++    fields.windows(2).find_map(|window| {
++        if is_tar_date(window[1]) {
++            window[0].parse::<u64>().ok()
++        } else {
++            None
++        }
++    })
