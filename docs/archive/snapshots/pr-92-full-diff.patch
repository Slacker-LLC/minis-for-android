+#[cfg(unix)]
+pub fn acquire_lifecycle_lock() -> Result<std::sync::MutexGuard<'static, ()>, String> {
+    LIFECYCLE_LOCK
+        .get_or_init(|| std::sync::Mutex::new(()))
+        .lock()
+        .map_err(|_| "runtime lifecycle lock is poisoned".into())
+}
