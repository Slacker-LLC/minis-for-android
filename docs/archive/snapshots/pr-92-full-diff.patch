+#[cfg(unix)]
+fn clear_state_file(name: &str) -> Result<Value, (ErrorCode, String)> {
+    let path = std::path::Path::new(state_path(name)?);
+    safe_remove(path)?;
+    Ok(json!({"name": name, "cleared": true}))
+}
