++            .unwrap_or(false)
++        {
++            ensure_parent_dirs(parent, &resolved.root, uid, gid)?;
++        } else if !parent.is_dir() {
++            return Err((
++                ErrorCode::RuntimeUnavailable,
++                format!("parent directory is missing: {}", parent.display()),
