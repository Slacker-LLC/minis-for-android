++#[cfg(unix)]
++fn kill_process_group(pid: u32) {
++    let pid = pid as libc::pid_t;
++    unsafe {
++        libc::kill(-pid, libc::SIGKILL);
++        libc::kill(pid, libc::SIGKILL);
++    }
++}
++
++#[cfg(unix)]
++fn run_capture(
++    mut command: std::process::Command,
++    max_output: usize,
++    timeout: std::time::Duration,
++) -> Result<(std::process::ExitStatus, Vec<u8>), String> {
++    use std::io::Read;
