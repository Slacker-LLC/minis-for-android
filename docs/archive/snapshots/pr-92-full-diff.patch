++    let text = String::from_utf8(output).map_err(|_| {
++        (
++            ErrorCode::RuntimeUnavailable,
++            "package manager returned non-utf-8 output".into(),
++        )
++    })?;
++    let raw_path = text
++        .lines()
++        .map(str::trim)
++        .find_map(|line| line.strip_prefix("package:"))
++        .map(str::trim)
