++                Some(count) => count,
++                None => reader
++                    .take()
++                    .expect("reader handle exists")
++                    .join()
++                    .map_err(|_| (ErrorCode::Internal, "archive output reader failed".into()))?
++                    .map_err(|error| (ErrorCode::RootfsInvalid, error))?,
