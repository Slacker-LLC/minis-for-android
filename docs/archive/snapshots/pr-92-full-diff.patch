++        (
++            ErrorCode::RuntimeUnavailable,
++            format!("hash staged archive failed: {detail}"),
++        )
++    })?;
++    if !status.success() {
++        return Err((
++            ErrorCode::RuntimeUnavailable,
++            "sha256sum could not read staged archive".into(),
