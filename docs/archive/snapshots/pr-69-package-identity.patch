+class LinuxPythonRunHandler : ToolHandler {
+    override val definition: AgentToolDefinition = AgentToolDefinition(
+        name = "linux.python.run",
+        description = "Run Python 3 code in the on-device Ubuntu 24.04 environment (uid 10000). " +
+            "Pass code as a string; it is written to /workspace and executed with python3. " +
+            "Workspace is /workspace; use linux.file.write for files first if the script is long.",
+        parameters = mapOf(
+            "tool_title" to io.github.slackerllc.minis.data.model.AgentToolParam("string", "A concise 5-10 word summary shown to the user."),
+            "code" to io.github.slackerllc.minis.data.model.AgentToolParam("string", "Python 3 code to execute."),
+            "timeout" to io.github.slackerllc.minis.data.model.AgentToolParam("integer", "Timeout in seconds (default 300, max 900)."),
