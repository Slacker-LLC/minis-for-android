<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android's network-security-config cannot enumerate user-entered
         runtime LAN hosts, so platform cleartext capability stays enabled.
         This is transport plumbing, NOT the trust policy: ProviderTransportPolicy
         permits HTTP only for an explicitly configured API-key provider origin,
         blocks OAuth/update cleartext, and prevents insecure redirects. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- No <domain-config> for localhost / 127.0.0.1: base-config above already permits cleartext, and on
         Android 17 the duplicate rule made the separate process started for VScreen (then a Shizuku
         UserService; now the libsu root process) die during startup
         ("Found multiple conflicting per-domain rules"). -->
</network-security-config>
