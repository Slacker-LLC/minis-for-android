          "gemini-3-flash-preview",
          "gemini-2.5-pro",
          "gemini-2.5-flash",
          "gemini-2.5-flash-lite",
          "gpt-5.3-codex",
          "gpt-5.2-codex",
          "gpt-5.1-codex-max",
          "gpt-5.2",
          "gpt-4o",
          "gpt-4o-mini",
          "o3",
          "o4-mini",
          "codex-mini-latest",
          "anthropic/claude-sonnet-4",
          "google/gemini-2.5-flash",
          "openai/gpt-4o",
          "meta-llama/llama-4-maverick",
          "grok-4.6",
