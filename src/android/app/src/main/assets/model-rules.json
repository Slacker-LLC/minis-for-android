{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "gpt-6-astra-capabilities",
      "match": {
        "idExact": [
          "gpt-6-astra"
        ],
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "MAX",
        "supportsReasoning": true,
        "contextWindow": 1050000,
        "maxOutputTokens": 128000,
        "reasoningEffortValues": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "inputModalities": [
          "text",
          "image"
        ],
        "outputModalities": [
          "text"
        ],
        "rejectsTemperature": true
      }
    },
    {
      "id": "gpt-5.6-sol-terra-family",
      "match": {
        "idPrefix": [
          "gpt-5.6-sol",
          "gpt-5.6-terra"
        ]
      },
      "set": {
        "maxThinkingLevel": "MAX"
      }
    },
    {
      "id": "gpt-5.6-luna-family",
      "match": {
        "idPrefix": [
          "gpt-5.6-luna"
        ]
      },
      "set": {
        "maxThinkingLevel": "MAX"
      }
    },
    {
      "id": "gpt-6-sol-luna-family",
      "match": {
        "idPrefix": [
          "gpt-6-sol",
          "gpt-6-luna",
          "gpt-6.1-sol"
        ],
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "MAX",
        "supportsReasoning": true
      }
    },
    {
      "id": "gpt-5.5-family",
      "match": {
        "idPrefix": [
          "gpt-5.5"
        ]
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-openai-reasoning-family-ceiling",
      "match": {
        "idPrefix": [
          "gpt-5",
          "o1",
          "o3",
          "o4"
        ]
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-codex-family-ceiling",
      "match": {
        "idContains": [
          "codex"
        ]
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-hermes-reasoning-ceiling",
      "match": {
        "idContains": [
          "hermes"
        ]
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-qwen-family-ceiling",
      "match": {
        "idContains": [
          "qwen"
        ]
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "claude-opus-4-family",
      "match": {
        "idPrefix": [
          "claude-opus-4"
        ],
        "normalizeDots": true,
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "MAX"
      }
    },
    {
      "id": "known-anthropic-family-ceiling",
      "match": {
        "idPrefix": [
          "claude-3-7",
          "claude-opus-3-7",
          "claude-sonnet-3-7",
          "claude-haiku-3-7",
          "claude-4",
          "claude-opus-4",
          "claude-sonnet-4",
          "claude-haiku-4",
          "claude-fable-5",
          "claude-opus-5",
          "claude-sonnet-5",
          "claude-haiku-5",
          "claude-5"
        ],
        "normalizeDots": true,
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-gemini-family-ceiling",
      "match": {
        "idPrefix": [
          "gemini-"
        ],
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "known-grok-family-ceiling",
      "match": {
        "idPrefix": [
          "grok-"
        ],
        "stripPath": true
      },
      "set": {
        "maxThinkingLevel": "XHIGH"
      }
    },
    {
      "id": "mimo-agnes-reasoning-ceiling",
      "match": {
        "idContains": [
          "mimo",
          "agnes"
        ]
      },
      "set": {
        "maxThinkingLevel": "HIGH"
      }
    },
    {
      "id": "bytedance-seed-reasoning-ceiling",
      "match": {
        "idContains": [
          "seed-",
          "bytedance-seed"
        ]
      },
      "set": {
        "maxThinkingLevel": "HIGH"
      }
    },
    {
      "id": "openai-reasoning-prefixes",
      "match": {
        "idPrefix": [
          "gpt-5",
          "o1",
          "o3",
          "o4"
        ]
      },
      "set": {
        "supportsReasoning": true
      }
    },
    {
      "id": "openai-codex-reasoning",
      "match": {
        "idContains": [
          "codex"
        ]
      },
      "set": {
        "supportsReasoning": true
      }
    },
    {
      "id": "claude-extended-thinking",
      "match": {
        "idPrefix": [
          "claude-3-7",
          "claude-opus-3-7",
          "claude-sonnet-3-7",
          "claude-haiku-3-7",
          "claude-4",
          "claude-opus-4",
          "claude-sonnet-4",
          "claude-haiku-4",
          "claude-fable-5",
          "claude-opus-5",
          "claude-sonnet-5",
          "claude-haiku-5",
          "claude-5"
        ],
        "normalizeDots": true,
        "stripPath": true
      },
      "set": {
        "supportsReasoning": true
      }
    },
    {
      "id": "claude-adaptive-thinking-and-temperature",
      "match": {
        "idPrefix": [
          "claude-opus-4-6",
          "claude-opus-4-7",
          "claude-opus-4-8",
          "claude-sonnet-4-6",
          "claude-sonnet-4-7",
          "claude-sonnet-4-8",
          "claude-haiku-4-6",
          "claude-haiku-4-7",
          "claude-haiku-4-8",
          "claude-4-6",
          "claude-4-7",
          "claude-4-8",
          "claude-fable-5",
          "claude-opus-5",
          "claude-sonnet-5",
          "claude-haiku-5",
          "claude-5"
        ],
        "normalizeDots": true,
        "stripPath": true
      },
      "set": {
        "adaptiveThinking": true,
        "rejectsTemperature": true
      }
    },
    {
      "id": "gemini-3-thought-signature",
      "match": {
        "idPrefix": [
          "gemini-3"
        ],
        "stripPath": true
      },
      "set": {
        "requiresThoughtSignature": true
      }
    },
    {
      "id": "known-static-model-thinking-ceilings",
      "match": {
        "idExact": [
          "claude-fable-5",
          "claude-sonnet-5",
          "claude-sonnet-4-6",
          "claude-haiku-4-5",
