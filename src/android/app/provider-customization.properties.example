# provider-customization.properties.example
#
# Template for build-time customization values. Copy this file to
# provider-customization.properties (same directory) and fill in the values.
#
# Public/default builds may leave a value empty or omit this file entirely; the
# affected integration is then compiled with an explicit disabled capability
# and the BuildConfig value NOT_AVAILABLE_IN_THIS_BUILD. Private/production
# builds should pass -PproviderCustomizationRequired=true, which fails Gradle
# configuration when the file, key, or non-blank value is missing.

# Only needed to sign in with Claude OAuth credentials (API keys do not need
# it). Requests authenticated with OAuth must open their system prompt with
# the identifying line Claude Code itself sends, or the endpoint rejects them.
# We ship no private value — supply your own in provider-customization.properties.
ANTHROPIC_OAUTH_IDENTIFIER_PROMPT=
